{
  "name": "@vd/app",
  "productName": "Version Driver",
  "version": "0.1.0",
  "description": "Encrypted, compressed, Google Drive-backed version control",
  "main": "out/main/index.js",
  "author": "Landen Guthrie",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder -c.directories.output=../../installers",
    "pack": "electron-vite build && electron-builder --win --dir -c.directories.output=../../installers",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@vd/core": "*",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0",
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.versiondriver.app",
    "productName": "Version Driver",
    "copyright": "Copyright \u00a9 Landen Guthrie",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Version Driver",
        "schemes": [
          "versiondriver"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "electronVersion": "44.5.1"
  }
}